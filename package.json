{
  "name": "legaldriver",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "guard:copy": "node scripts/no-source-mechanics.mjs",
    "db:types": "supabase gen types typescript --linked > src/lib/db/database.types.ts",
    "gen:routes": "node scripts/gen-routes.mjs",
    "gen:bar-councils": "node scripts/gen-bar-councils.mjs",
    "gen:advocate-scopes": "node scripts/gen-advocate-scopes.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "verify:ld-key": "node scripts/verify-ld-api-key.mjs",
    "test:e2e": "npm run gen:routes && playwright test",
    "test:e2e:ui": "npm run gen:routes && playwright test --ui",
    "test:e2e:update": "npm run gen:routes && playwright test --update-snapshots",
    "test:qa": "node qa-agent/findings.test.mjs",
    "qa:sweep": "npm run gen:routes && node qa-agent/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@aws-sdk/client-athena": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@headlessui/react": "^2.2.10",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.45.4",
    "@xenova/transformers": "^2.17.2",
    "next": "14.2.15",
    "next-intl": "^3.26.5",
    "pdf-to-img": "^4.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.2",
    "tesseract.js": "^5.1.1",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "playwright": "^1.61.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3"
  }
}
