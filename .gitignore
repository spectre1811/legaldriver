# deps
node_modules
.pnp
.pnp.js

# env / secrets — never commit
.env
.env.local
.env*.local
*.pem

# next / build
.next/
out/
build/
dist/
next-env.d.ts

# vercel / supabase
.vercel
.supabase/
supabase/.branches
supabase/.temp

# typescript build info
*.tsbuildinfo

# test / coverage
coverage/
.nyc_output/

# misc
.DS_Store
*.log
npm-debug.log*
.idea/
.vscode/*
!.vscode/extensions.json

# tesseract.js lang models (downloaded at runtime; worker cache)
*.traineddata

# Claude Code — commit shared config/memory, never the local/secret bits
.claude/settings.local.json
.claude/**/*.local.*
.claude/.credentials.json
.claude/**/*.jsonl

# never commit session transcripts/artifacts
.claude-sessions/

# WO-36 · Playwright E2E — commit specs/config/visual baselines; ignore auth state + run artifacts
playwright/.auth/
test-results/
playwright-report/
blob-report/

# WO-36 Layer 2 · QA agent — generated sweep reports are run artifacts (uploaded in CI); ignore them.
# (Playwright visual baselines under e2e/*-snapshots/ ARE committed — do not ignore those.)
qa-reports/
