# ── Supabase ─────────────────────────────────────────────
# From Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only, never expose to the client

# ── Document classification (Claude) ─────────────────────
# Backend: auto (default) = API if ANTHROPIC_API_KEY set, else local Claude Code CLI.
#   api = Anthropic API (fast, scalable; needs key) · cli = local `claude` CLI
#   (uses machine OAuth creds, no key; local/self-hosted only) · off = needs-review only
CLASSIFIER_BACKEND=auto
ANTHROPIC_API_KEY=                    # optional — leave empty to use the local CLI backend
DOC_CLASSIFY_MODEL=claude-haiku-4-5   # classification model (cheap, structured-output capable)
CONFIDENCE_THRESHOLD=0.7              # >= → auto-file; below → needs-review queue

# ── Court data ───────────────────────────────────────────
COURT_DATA_PROVIDER=mock          # "mock" (free, default) | "ecourtsindia" (live)
ECOURTSINDIA_API_TOKEN=           # Bearer token, free signup credits
# ECOURTSINDIA_BASE_URL=https://webapi.ecourtsindia.com  # override if needed

# ── Cron (Vercel Cron / scheduled jobs) ──────────────────
CRON_SECRET=                      # shared secret; cron requests send it as Bearer

# ── Google OAuth (Gmail, gmail.readonly) ─────────────────
# Google Cloud console → OAuth client. Keep consent screen in "Testing".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Email delivery (Resend) ──────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=                       # verified sender, e.g. no-reply@yourdomain

# ── App ──────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000

# ── Phase 2 (not yet wired; add when building the module) ─
# Payments (Razorpay) — P6 billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# WhatsApp (Meta BSP — AiSensy/Wati/Gupshup/Interakt/Twilio) — P10
WHATSAPP_BSP_API_KEY=
WHATSAPP_BSP_PHONE_NUMBER_ID=
WHATSAPP_BSP_BASE_URL=
# Aadhaar eSign / eStamp (Leegality or Digio) — P7
ESIGN_PROVIDER=                   # leegality | digio
ESIGN_API_KEY=
ESIGN_API_SECRET=
# (pgvector for the AI copilot is a Supabase extension — enable via migration, no key)

# ── Phase 3 (services — all behind seams; live path flips on when key appears) ─
# Court Data Gateway (E7): cache TTL + multi-provider routing (mock/eCourtsIndia work today)
COURT_CACHE_TTL_MS=43200000       # 12h read-through cache freshness window
VAKEEL360_API_KEY=                # secondary court provider (routing/failover) — optional
KANOON_DEV_API_KEY=               # secondary court provider — optional
# Messaging Gateway (E1): WhatsApp BSP inbound/outbound (reuses WHATSAPP_BSP_* above)
WHATSAPP_BSP_WEBHOOK_VERIFY_TOKEN=
MESSAGING_PROVIDER=mock           # mock | whatsapp_bsp
MESSAGING_DEFAULT_TENANT_ID=      # webhook fallback until a firm-number→tenant map exists
# Voice / Call Service (E5): cloud telephony + Indic STT
TELEPHONY_PROVIDER=               # exotel | knowlarity
TELEPHONY_API_KEY=
TELEPHONY_API_TOKEN=
TELEPHONY_SUBDOMAIN=
STT_PROVIDER=                     # whisper | sarvam | ai4bharat
STT_API_KEY=
# AI / Lawyer Agent (E6): legal-research grounding + RAG embeddings
INDIANKANOON_API_KEY=             # precedents + cited-by validity
EMBEDDINGS_PROVIDER=              # voyage | openai  (Anthropic has no embeddings API)
EMBEDDINGS_API_KEY=
AGENT_BACKEND=cli                 # cli (self-hosted Claude Code, keyless) | api (ANTHROPIC_API_KEY)
