# ── Supabase ─────────────────────────────────────────────
# From Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only, never expose to the client

# ── Document classification (Claude) ─────────────────────
# Backend: auto (default) = API if ANTHROPIC_API_KEY set, else local Claude Code CLI.
#   api = Anthropic API (fast, scalable; needs key) · cli = local `claude` CLI
#   (uses machine OAuth creds, no key; local/self-hosted only) · off = needs-review only
CLASSIFIER_BACKEND=auto
ANTHROPIC_API_KEY=                    # optional — leave empty to use the local CLI backend
DOC_CLASSIFY_MODEL=claude-haiku-4-5   # classification model (cheap, structured-output capable)
CONFIDENCE_THRESHOLD=0.7              # >= → auto-file; below → needs-review queue

# ── Court data ───────────────────────────────────────────
COURT_DATA_PROVIDER=mock          # "mock" (free, default) | "ecourtsindia" (live)
ECOURTSINDIA_API_TOKEN=           # Bearer token, free signup credits
# ECOURTSINDIA_BASE_URL=https://webapi.ecourtsindia.com  # override if needed

# ── Cron (Vercel Cron / scheduled jobs) ──────────────────
CRON_SECRET=                      # shared secret; cron requests send it as Bearer
CRON_LOCK=                        # "1" = cron lease mutex active (WO-355) — leave unset until table applied
NOTIFY_SEND_TIMEOUT_MS=           # per-send abort, default 10000 (WO-378); raise only with send-latency evidence

# ── Critical alerts (WO-311) ─────────────────────────────
# HTTPS ingress of the SHARED alarm-forwarder (SNS → forwarder Lambda → the one
# "Critical AWS Alerts" Google Chat space). This is NOT the Chat webhook — the
# forwarder reads that from Secrets Manager at runtime; it must never be committed
# or pasted here. Unset ⇒ alerts are logged loudly and skipped; the caller's
# durable record (court_provider_health) still lands.
OPS_ALERT_WEBHOOK_URL=

# ── Google OAuth (Gmail, gmail.readonly) ─────────────────
# Google Cloud console → OAuth client. Keep consent screen in "Testing".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Email delivery (Resend) ──────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=                       # verified sender, e.g. no-reply@yourdomain

# ── Invite-only access (WO-272) ──────────────────────────
ACCESS_REQUEST_NOTIFY=yash@mukadma.in   # who gets "someone requested access"; comma-list ok
ADMIN_EMAILS=yash@mukadma.in            # allowlist for the /dashboard/access-requests admin console (W2)

# ── App ──────────────────────────────────────────────────
# This app's own base URL (OAuth/capture-bookmarklet targets). Prod = https://app.mukadma.in (WO-162).
APP_BASE_URL=http://localhost:3000

# Public case-search cross-link target (mukadma-search). Unset → https://search.mukadma.in (WO-162).
NEXT_PUBLIC_SEARCH_URL=https://search.mukadma.in

# ── Phase 2 (not yet wired; add when building the module) ─
# Payments (Razorpay) — P6 billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# WhatsApp (Meta BSP — AiSensy/Wati/Gupshup/Interakt/Twilio) — P10
WHATSAPP_BSP_API_KEY=
WHATSAPP_BSP_PHONE_NUMBER_ID=
WHATSAPP_BSP_BASE_URL=
# Aadhaar eSign / eStamp (Leegality or Digio) — P7
ESIGN_PROVIDER=                   # leegality | digio
ESIGN_API_KEY=
ESIGN_API_SECRET=
# (pgvector for the AI copilot is a Supabase extension — enable via migration, no key)

# ── Phase 3 (services — all behind seams; live path flips on when key appears) ─
# Court Data Gateway (E7): cache TTL + multi-provider routing (mock/eCourtsIndia work today)
COURT_CACHE_TTL_MS=43200000       # 12h read-through cache freshness window
VAKEEL360_API_KEY=                # secondary court provider (routing/failover) — optional
KANOON_DEV_API_KEY=               # secondary court provider — optional
# Messaging Gateway (E1): WhatsApp BSP inbound/outbound (reuses WHATSAPP_BSP_* above)
WHATSAPP_BSP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=              # Meta app secret → verifies inbound webhook HMAC (fail-closed once set)
MESSAGING_PROVIDER=mock           # mock | whatsapp_bsp
# WO-311: there is NO tenant-default env any more. Inbound messages route ONLY via
# the `messaging_identity` table (receiving phone_number_id / DID → tenant). Seed a
# row per WABA number; an unmapped number is refused, recorded and alerted.
# Voice / Call Service (E5): cloud telephony + Indic STT
TELEPHONY_PROVIDER=               # exotel | knowlarity
TELEPHONY_API_KEY=
TELEPHONY_API_TOKEN=
TELEPHONY_SUBDOMAIN=
TELEPHONY_WEBHOOK_SECRET=         # HMAC-SHA256 shared secret; UNSET ⇒ /api/voice/telephony hard-refuses 503 (WO-311)
STT_PROVIDER=                     # whisper | sarvam | ai4bharat
STT_API_KEY=
# AI / Lawyer Agent (E6): legal-research grounding + RAG embeddings
INDIANKANOON_API_KEY=             # precedents + cited-by validity
EMBEDDINGS_PROVIDER=              # voyage | openai  (Anthropic has no embeddings API)
EMBEDDINGS_API_KEY=
AGENT_BACKEND=cli                 # cli (self-hosted Claude Code, keyless) | api (ANTHROPIC_API_KEY) | deepseek
# DeepSeek — optional reasoning LLM (OpenAI-compatible). Set AGENT_BACKEND=deepseek to use it.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro    # deepseek-v4-pro (reasoning) | deepseek-v4-flash (faster/cheaper)

# ── Court corpus lake (S3 + Athena) — scoped read-only IAM key ─
CORPUS_AWS_ACCESS_KEY_ID=
CORPUS_AWS_SECRET_ACCESS_KEY=
CORPUS_AWS_REGION=ap-south-1
CORPUS_BUCKET=
ATHENA_DB=legaldriver_corpus
ATHENA_OUTPUT=

# ── Provider-agnostic LLM (any OpenAI-compatible endpoint) ─
# Set LLM_PROVIDER=custom to route the whole app through LLM_BASE_URL/_API_KEY/_MODEL
# (OpenAI, Together, Groq, Ollama/vLLM, etc.). Or per-call opts.backend.
LLM_PROVIDER=                     # custom | deepseek | (empty = Claude API/CLI default)
LLM_BASE_URL=                     # e.g. https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# ── AI GATEWAY (WO-02) ── the one seam every AI call goes through (04-AI §0). The
# route table lives in src/lib/ai/gateway/routes.ts (config, not code). These are
# OPTIONAL: unset → the gateway stays keyless (local Claude CLI). Set the LiteLLM
# vars to route through the self-hosted proxy; set LANGFUSE_* to ship traces.
# Run the local backends with: docker compose -f docker-compose.ai.yml up -d
LITELLM_BASE_URL=                 # e.g. http://localhost:4000/v1 (LiteLLM proxy)
LITELLM_API_KEY=                  # LiteLLM master key (== LITELLM_MASTER_KEY)
LITELLM_MODEL=                    # proxy model name to request (default: cheap)
LITELLM_MASTER_KEY=               # docker-compose.ai.yml only — the proxy's admin key
LANGFUSE_HOST=                    # e.g. http://localhost:3001 (empty → no Langfuse, stdout traces only)
LANGFUSE_PUBLIC_KEY=              # pk-lf-… (create a project in the Langfuse UI)
LANGFUSE_SECRET_KEY=              # sk-lf-…
LANGFUSE_NEXTAUTH_SECRET=         # docker-compose.ai.yml only
LANGFUSE_SALT=                    # docker-compose.ai.yml only

# ── OCR (scanned / Indic-language documents) ── provider seam, env-routed.
# Default is keyless on-box Tesseract.js; Google Vision is an optional quality fallback.
OCR_PROVIDER=                     # tesseract | surya | google | auto (default: auto → best on-box engine)
OCR_FALLBACK=                     # tesseract | surya | google | none (default: smart on-box)
OCR_MIN_CONFIDENCE=               # escalate to fallback below this 0..1 (default: 0.6)
OCR_MAX_PAGES=                    # cap pages OCR'd per PDF (default: 20)
TESSERACT_LANGS=                  # tesseract.js langs, e.g. eng+guj+hin (default: eng+guj+hin)
TESSERACT_DATA=                   # best | fast — tessdata_best (accurate, default) vs _fast (quicker)
TESSERACT_LANG_PATH=              # override the traineddata CDN/dir (default: projectnaptha best)
SURYA_OCR_CMD=                    # path to the Surya CLI (e.g. surya_ocr) → on-box SOTA OCR, no per-page cost
SURYA_TIMEOUT_MS=                 # Surya subprocess timeout (default: 240000)
GOOGLE_VISION_API_KEY=           # OPTIONAL convenience tier (DOCUMENT_TEXT_DETECTION) — bytes leave our box
OCR_DISABLED=                     # set 1 to disable the worker OCR tick

# ── LegalDriver court-data API (our own, compliant) ── replaces the eCourts path.
# When LD_API_KEY is set it becomes the CourtDataClient (case-by-CNR, advocate
# caseload by bar/name, cause list, orders/PDFs) AND an advocate auto-fetch provider.
COURT_DATA_PROVIDER=              # legaldriver | mock | ecourtsindia (auto → legaldriver when LD_API_KEY set)
LD_API_KEY=                       # ld_xxxxxxxx… (X-API-Key header). RAW key only — NOT an encrypted
                                  # {"v":…,"c":…} envelope (WO-64 rot). Store as a READABLE (non-"sensitive")
                                  # Vercel env so it can be read back + verified. Verify: node scripts/verify-ld-api-key.mjs
LD_API_BASE=                      # default http://43.205.90.255:8080
LD_API_TIMEOUT_MS=                # default 60000 (live eCourts fallback can take 3–6s)
LD_API_CANARY_BAR_ID=             # WO-64 synthetic-canary target (default G/702/2020 — a known non-empty roster)
LD_API_CANARY_TIMEOUT_MS=         # default 15000 — the /api/cron/ld-api-canary auth probe timeout
LD_ADVOCATE_STATEWIDE_FANOUT=     # BP-74 W3: "1" = onboarding fires ONE server-side `refresh-statewide` job
                                  # (rotating-IP fan-out over EVERY district) instead of the per-scope loop.
                                  # DEFAULT OFF — flip ON only AFTER the on-demand fan-out drainer is deployed
                                  # (ecourts BP-74 W3a), else jobs enqueue with nothing to drain them.
LD_REFRESH_TIMEOUT_MS=            # default 20000 — per fire-and-forget roster-refresh POST timeout
COURT_PARTY_TEXT_SEARCH=          # "1" to enable substring party search on the cases list — ONLY after migration 0030 (party_text + trigram) is applied (WO-35 #5)

# ── WO-326: mukadma.in apex public search/stats proxy ── DISTINCT from LD_API_BASE/LD_API_KEY above.
# `src/app/api/public/{search,stats}/route.ts` forward to the scraper's PUBLIC surface
# (`/v1/public/*` — suppression-filtered, no API key) for the anonymous apex landing (founder
# decision, WO-326). Server-only; fail-closed (unset → the route 500s, never a hardcoded fallback).
SCRAPER_API_BASE=                 # e.g. https://<sealed-hostname> — same box as LD_API_BASE, public surface

# Analytics (WO-15) — product events via PostHog (self-serve free). Unset = no-op (no tracking).
# Server-side capture only; NEVER put PII/CNRs in event props (enforced by src/lib/analytics).
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ── Demo / showcase (WO-08) ──────────────────────────────
# DEMO_MODE sandboxes ALL outbound (email + WhatsApp) → nothing reaches a real
# person, regardless of provider keys. Set on the demo/staging deploy only.
DEMO_MODE=                        # 1 | true | on  → sandbox outbound (default off)
DEMO_EMAIL=                       # senior advocate login (default demo@lexdriver.test)
DEMO_EMAIL2=                      # junior advocate (default demo.junior@lexdriver.test)
DEMO_PASSWORD=                    # demo login password (default peshi-demo-1234)
